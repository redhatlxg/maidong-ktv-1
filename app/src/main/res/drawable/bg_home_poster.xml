<?xml version="1.0" encoding="utf-8"?>
<!-- 新歌榜海报背景: 古装美人占位(没有图片时使用渐变) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF637D91"
                android:centerColor="#FF425C72"
                android:endColor="#FF2E465B"
                android:type="linear" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 中间:圆月 -->
    <item android:gravity="center" android:width="160dp" android:height="160dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:startColor="#66E7C994"
                android:centerColor="#33D7B98A"
                android:endColor="#00D7B98A" />
        </shape>
    </item>
</layer-list>
