<?xml version="1.0" encoding="utf-8"?>
<!-- KTV 主播放窗口：深炭黑底与克制的酒红边框 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF171D26" android:endColor="#FF090D13"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="#66D94357"/>
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00000000" android:endColor="#AA090D13" android:type="linear"/>
        </shape>
    </item>
</layer-list>
