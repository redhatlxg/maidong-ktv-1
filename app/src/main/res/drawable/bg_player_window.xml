<?xml version="1.0" encoding="utf-8"?>
<!-- MV窗口：低反光深色边框，避免抢占画面 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#FF080D16"/><corners android:radius="8dp"/><stroke android:width="1dp" android:color="#FF34445F"/></shape></item>
    <item android:gravity="bottom"><shape android:shape="rectangle"><gradient android:angle="90" android:startColor="#00000000" android:endColor="#99080D16" android:type="linear"/></shape></item>
</layer-list>