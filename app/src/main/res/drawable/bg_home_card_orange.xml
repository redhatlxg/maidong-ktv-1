<?xml version="1.0" encoding="utf-8"?>
<!-- 晓晓呀KTV首页分类卡片：统一霓虹紫蓝舞台配色 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item><shape android:shape="rectangle">
  <gradient android:angle="45" android:startColor="#FFFFC76B" android:centerColor="#FFE7A34F" android:endColor="#FF9A5B48" android:type="linear"/>
  <corners android:radius="16dp"/>
 </shape></item>
 <item android:gravity="right|bottom">
  <shape android:shape="rectangle">
   <size android:width="150dp" android:height="150dp"/>
   <gradient android:angle="135" android:startColor="#40FFFFFF" android:centerColor="#16FFFFFF" android:endColor="#00000000"/>
   <corners android:radius="16dp"/>
  </shape>
 </item>
</layer-list>